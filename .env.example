# Server
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite:///./data/pnl_monitor.db

# File uploads
MAX_FILE_MB=50
UPLOAD_DIR=./data/uploads

# Target ranges (% of revenue)
TARGET_MANPOWER_MIN=20
TARGET_MANPOWER_MAX=28
TARGET_PACKAGING_MIN=5
TARGET_PACKAGING_MAX=10
TARGET_POWER_FUEL_MIN=3
TARGET_POWER_FUEL_MAX=7
TARGET_RENT_MIN=8
TARGET_RENT_MAX=15
TARGET_EQUIPMENT_MIN=2
TARGET_EQUIPMENT_MAX=5
TARGET_OVERHEADS_MIN=3
TARGET_OVERHEADS_MAX=7

# Margin targets
TARGET_CM1_MIN=65
TARGET_CM1_MAX=70
TARGET_CM2_MIN=15
TARGET_CM2_MAX=30
CM_TOLERANCE=3


OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=10
INSIGHT_MODE=auto
# auto mode only: total seconds the whole upload's insight step may spend
# attempting LLM calls before the rest of the batch falls back to rule-based
# instantly. Keeps large uploads bounded regardless of row count.
INSIGHT_BATCH_BUDGET_SECONDS=8

# Notifications
NOTIFY_CHANNEL=file
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_RECIPIENTS=

WEBHOOK_URL=
